// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("PRISMA_DATABASE_CONNECTION_URL")
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique @db.VarChar(320)
  password String
  lcUsername String @db.VarChar(240) @default("")
  lcSessionToken String @db.Text @default("")
  userAvatar      String? 
  inboxSender    Inbox[] @relation("sender")
  inboxrecipient Inbox[] @relation("recipient")
  isProfileVerified Boolean @default(false) // for leetcode profile verification
  // New: to define the relation to the group
  groups      Group[] // A user can belong to many groups
  userPreference  Preference[] @relation("userPreference")
}


model Group {
 id            Int     @id @default(autoincrement())
 uniqueGroupId String  @unique @default(cuid())
 groupName     String
 numberOfUsers Int     @default(0) // default to 0 for new groups
 isActive      Boolean @default(true) // default to true for new groups
 users         User[] // A group can have many users
}


model Inbox {
  id            Int     @id @default(autoincrement())   
  sender        User    @relation("sender", fields: [senderId], references: [id])
  senderId      Int 
  recipient     User    @relation("recipient", fields: [recipientId], references: [id])
  recipientId   Int
  context       String  @db.TinyText @default("")
  isInvitation  Boolean
  acknowledgement Acknowledgement @default(RECEIVED)
}

model Preference {
  id                  Int     @id @default(autoincrement())
  user                User    @relation("userPreference", fields: [userId], references: [id])
  userId              Int     @unique
  //All notifications
  isNotify            Boolean @default(true)
  //Only auto notifications: streak, check in today, daily problem
  isAutoNotify        Boolean @default(true)
  isInboxNotify       Boolean @default(true)
  isEmailNotify       Boolean @default(false)   //Email is default false since user need to verify it first
  //Only auto notifications above and messages and invitation
  isWebPushNotify     Boolean @default(true)
  //Auto Notification individually
  isStreakNotify      Boolean @default(true)
  isCheckinNotify     Boolean @default(true)
  isProblemNotify     Boolean @default(true)
  //The Message and Invitation itself individually
  isInboxMessage      Boolean @default(true)
  isEmailMessage      Boolean @default(false)   //Email is default false since user need to verify it first
  //Message and Invitation to Web push individually
  isWebPushMessage     Boolean @default(true)
  //Date time for auto notification to trigger
  autoStreakDatetime  DateTime @default(now())
  autoCheckinDatetime DateTime @default(now())
  autoProblemDatetime DateTime @default(now())
  //Interval of auto notification between any two triggers
  autoStreakInterval  NotificationInterval @default(HOURLY)
  autoCheckinInterval NotificationInterval @default(HOURLY)
  autoProblemInterval NotificationInterval @default(FULL_DAY)
}

enum Acknowledgement {
  ACCEPT
  ARCHIVED
  VIEWED
  RECEIVED
}

// Prisma is currently having a bug on this mapping. It may be resolved in the near future
// but the current resolution is to introduce a similar mapping on the client side
enum NotificationInterval {
  HOURLY            @map("1")
  EIGTH_DAY         @map("4")
  QUARTER_DAY       @map("6")
  HALF_DAY          @map("12")
  FULL_DAY          @map("24")
}